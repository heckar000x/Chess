{
  "name": "chess-legion",
  "version": "1.0.0",
  "description": "CHESS LEGION — The Four Minds Arena. Complete cross-platform chess with multi-agent Omega AI.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "server": "node server/server.js",
    "dev:all": "concurrently \"npm run server\" \"npm run dev\"",
    "test": "vitest run",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "chess.js": "^1.0.0-beta.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io-client": "^4.7.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.8",
    "concurrently": "^8.2.2"
  }
}
